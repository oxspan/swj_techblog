{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "include": [".astro/types.d.ts", "src/**/*", "astro.config.ts", "lib/newsletter.mjs"],
  "exclude": ["dist", "node_modules", ".omo", "app", "components", "layouts", "scripts"]
}
