{
  "name": "tailwind-nextjs-starter-blog",
  "version": "2.0.1",
  "private": true,
  "scripts": {
    "start": "next dev",
    "dev": "cross-env INIT_CWD=$PWD next dev",
    "build": "cross-env INIT_CWD=$PWD next build && node ./scripts/postbuild.mjs",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "lint": "next lint --dir app --dir components --dir layouts --dir scripts --dir lib --dir tests",
    "lint:fix": "yarn lint --fix",
    "typecheck": "tsc --noEmit",
    "audit": "yarn npm audit --all --recursive --no-deprecations",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@headlessui/react": "1.7.19",
    "@next/bundle-analyzer": "15.5.28",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.12",
    "autoprefixer": "^10.4.13",
    "contentlayer2": "0.5.8",
    "esbuild": "0.28.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.2",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "katex": "0.18.2",
    "ky": "^2.2.0",
    "next": "15.5.28",
    "next-contentlayer2": "0.5.8",
    "next-themes": "^0.3.0",
    "pliny": "0.4.1",
    "postcss": "^8.4.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.0.0",
    "rehype-katex": "^7.0.0",
    "rehype-preset-minify": "7.0.0",
    "rehype-prism-plus": "^2.0.0",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.0",
    "remark-gfm": "^4.0.0",
    "remark-github-blockquote-alert": "^1.2.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^3.4.3",
    "unist-util-visit": "^5.0.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.12",
    "@types/react": "^18.2.73",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.28",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^16.2.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "typescript": "^5.1.3"
  },
  "resolutions": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/core": "2.9.0",
    "@opentelemetry/resources": "2.9.0",
    "@opentelemetry/sdk-trace-base": "2.9.0",
    "@opentelemetry/sdk-trace-node": "2.9.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.220.0",
    "katex": "0.18.2",
    "toml": "5.0.1",
    "uuid": "11.1.1",
    "zod": "4.6.6",
    "js-yaml@npm:4.1.0": "4.3.2",
    "postcss": "^8.5.23",
    "postcss-selector-parser@npm:6.0.10": "6.1.5",
    "@contentlayer2/source-files@npm:0.5.8": "patch:@contentlayer2/source-files@npm%3A0.5.8#~/.yarn/patches/@contentlayer2-source-files-npm-0.5.8-ce955c9f07.patch",
    "@contentlayer2/utils@npm:0.5.8": "patch:@contentlayer2/utils@npm%3A0.5.8#~/.yarn/patches/@contentlayer2-utils-npm-0.5.8-f14c371a28.patch"
  },
  "engines": {
    "node": "^22.22.1 || ^24.0.0"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.18.1"
}
