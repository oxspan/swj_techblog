<section class="newsletter" aria-labelledby="newsletter-title">
  <div>
    <p class="eyebrow">새 기록 알림</p>
    <h2 id="newsletter-title">다음 기록을 이메일로 받아보세요.</h2>
    <p>새 글이 발행될 때만 알립니다. 요청 접수 후 서비스의 확인 절차가 이어질 수 있습니다.</p>
  </div>
  <form data-newsletter>
    <label for="newsletter-email">이메일</label>
    <div class="newsletter-fields">
      <input id="newsletter-email" name="email" type="email" autocomplete="email" required />
      <button type="submit">구독 요청</button>
    </div>
    <p class="form-status" data-newsletter-status aria-live="polite"></p>
  </form>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-newsletter]')
  const status = document.querySelector<HTMLElement>('[data-newsletter-status]')

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()
    if (!status) return
    const button = form.querySelector<HTMLButtonElement>('button')
    const data = new FormData(form)
    button?.setAttribute('disabled', '')
    status.textContent = '구독 요청을 보내고 있습니다.'
    try {
      const response = await fetch('/api/newsletter', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: data.get('email') }),
      })
      status.textContent = response.ok
        ? '구독 요청을 접수했습니다. 이메일을 확인해 주세요.'
        : response.status === 429
          ? '요청이 많습니다. 잠시 뒤 다시 시도해 주세요.'
          : '지금은 구독 요청을 처리할 수 없습니다.'
      if (response.ok) form.reset()
    } catch (error) {
      if (!(error instanceof TypeError)) throw error
      status.textContent = '네트워크 연결을 확인한 뒤 다시 시도해 주세요.'
    } finally {
      button?.removeAttribute('disabled')
    }
  })
</script>
