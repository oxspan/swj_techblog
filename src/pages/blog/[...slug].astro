---
import { render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Comments from '../../components/Comments.astro'
import NewsletterForm from '../../components/NewsletterForm.astro'
import { formatDate } from '../../lib/format'
import { getCatalog } from '../../lib/catalog'
import { site } from '../../config'

export async function getStaticPaths() {
  const { posts, series } = await getCatalog()
  return posts.map((entry) => {
    const collection = series.find((item) => item.posts.some((post) => post.id === entry.id))
    const position = collection?.posts.findIndex((post) => post.id === entry.id)
    return { params: { slug: entry.id }, props: { entry, collection, position } }
  })
}
const { entry, collection, position } = Astro.props
const { Content, headings } = await render(entry)
const previous = collection && position !== undefined ? collection.posts[position - 1] : undefined
const next = collection && position !== undefined ? collection.posts[position + 1] : undefined
---
<BaseLayout title={entry.data.title} description={entry.data.summary} image={entry.data.images?.[0] ?? site.socialImage} article>
  <header class="article-header">
    <p class="eyebrow">{collection ? collection.data.title : '기록'}</p>
    <h1>{entry.data.title}</h1>
    {entry.data.summary && <p class="summary">{entry.data.summary}</p>}
    <p class="article-meta">
      <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
      {entry.data.tags.map((tag) => <span>#{tag}</span>)}
    </p>
  </header>
  <div class="article-shell">
    <article class="article-body"><Content /></article>
    {headings.length > 0 && <>
      <button class="toc-open" type="button" data-toc-open aria-haspopup="dialog">목차</button>
      <nav class="table-of-contents toc-desktop" aria-label="이 글의 목차">
        <strong>이 글의 목차</strong>
        {headings.filter((heading) => heading.depth <= 3).map((heading) => <a href={`#${heading.slug}`} data-depth={heading.depth}>{heading.text}</a>)}
      </nav>
      <dialog class="toc-dialog" data-toc-dialog aria-labelledby="toc-dialog-title">
        <div class="dialog-header"><h2 id="toc-dialog-title">이 글의 목차</h2><button class="icon-button" type="button" data-toc-close aria-label="목차 닫기">×</button></div>
        <nav aria-label="모바일 글 목차">{headings.filter((heading) => heading.depth <= 3).map((heading) => <a href={`#${heading.slug}`} data-depth={heading.depth}>{heading.text}</a>)}</nav>
      </dialog>
    </>}
  </div>
  {collection && position !== undefined && <nav class="series-navigation" aria-label="시리즈 이어 읽기">
    <p><a href={`/series/${collection.id}`}>{collection.data.title}</a> · {position + 1}/{collection.posts.length}</p>
    <div class="series-navigation-links">
      {previous ? <a href={`/blog/${previous.id}`}><span>이전 글</span>{previous.data.title}</a> : <span></span>}
      {next && <a href={`/blog/${next.id}`}><span>다음 글</span>{next.data.title}</a>}
    </div>
  </nav>}
  <div class="page narrow"><NewsletterForm /></div>
  <div class="page narrow comments-wrap"><Comments /></div>
</BaseLayout>

<script>
  const tocDialog = document.querySelector<HTMLDialogElement>('[data-toc-dialog]')
  const tocOpen = document.querySelector<HTMLButtonElement>('[data-toc-open]')
  const tocClose = document.querySelector<HTMLButtonElement>('[data-toc-close]')
  tocOpen?.addEventListener('click', () => tocDialog?.showModal())
  tocClose?.addEventListener('click', () => tocDialog?.close())
  tocDialog?.addEventListener('close', () => window.setTimeout(() => tocOpen?.focus(), 0))

  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.toc-desktop a, .toc-dialog a')]
  const sections = [...document.querySelectorAll<HTMLElement>('.article-body h2[id], .article-body h3[id]')]
  const setCurrentSection = (id: string): void => {
    for (const link of tocLinks) {
      const current = decodeURIComponent(link.hash.slice(1)) === id
      if (current) link.setAttribute('aria-current', 'location')
      else link.removeAttribute('aria-current')
    }
  }
  const currentHashId = (): string | undefined => {
    const hash = window.location.hash.slice(1)
    return hash ? decodeURIComponent(hash) : undefined
  }
  for (const link of tocLinks) {
    link.addEventListener('click', () => {
      setCurrentSection(decodeURIComponent(link.hash.slice(1)))
      if (tocDialog?.contains(link)) tocDialog.close()
    })
  }
  window.addEventListener('hashchange', () => {
    const id = currentHashId()
    if (id) setCurrentSection(id)
  })
  const initialSection = currentHashId() ?? sections[0]?.id
  if (initialSection) setCurrentSection(initialSection)
  const observer = new IntersectionObserver(
    (entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((left, right) => left.boundingClientRect.top - right.boundingClientRect.top)
      const current = visible[0]?.target
      if (current instanceof HTMLElement) setCurrentSection(current.id)
    },
    { rootMargin: '-15% 0px -70% 0px' }
  )
  for (const section of sections) observer.observe(section)
</script>
