---
import BaseLayout from '../../layouts/BaseLayout.astro'
import SeriesList from '../../components/SeriesList.astro'
import { getCatalog } from '../../lib/catalog'
const { series } = await getCatalog()
---
<BaseLayout title="시리즈" description="처음부터 순서대로 읽을 수 있는 기술 시리즈">
  <div class="page">
    <p class="eyebrow">Series</p>
    <h1 class="page-title">시리즈</h1>
    <p class="lede">한 가지 질문을 여러 편에 걸쳐 깊게 살펴봅니다. 순서는 명시적으로 관리합니다.</p>
    <div class="section-heading"><h2>읽는 순서</h2></div>
    <SeriesList series={series} />
  </div>
</BaseLayout>
