---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getCatalog } from '../lib/catalog'
const { projects } = await getCatalog()
---
<BaseLayout title="프로젝트">
  <div class="page">
    <p class="eyebrow">Projects</p>
    <h1 class="page-title">프로젝트</h1>
    <p class="lede">직접 맡은 역할과 구현이 확인된 프로젝트를 기록합니다.</p>
    <ul class="record-list">
      {projects.map((project) => <li><span></span><article><h3>{project.data.title}</h3><p>{project.data.description}</p><p><a href={project.data.href}>원본 프로젝트 보기 →</a></p></article></li>)}
    </ul>
  </div>
</BaseLayout>
